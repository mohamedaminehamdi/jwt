{
  "openapi": "3.0.3",
  "info": {
    "title": "Jobs API",
    "version": "1.0.0",
    "description": "Track job applications. Register or log in to get a JWT, then send it as `Authorization: Bearer <token>`."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "Jobs"
    },
    {
      "name": "Health"
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Create an account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or email already used",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Log in",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing email or password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Current user",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Auth"
        ],
        "summary": "Update profile (returns a fresh token)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Auth"
        ],
        "summary": "Delete the account and all its jobs",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteAccountInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Account deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "400": {
            "description": "Missing or wrong password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/jobs": {
      "get": {
        "tags": [
          "Jobs"
        ],
        "summary": "List your jobs",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "interview",
                "declined",
                "pending"
              ]
            },
            "description": "Filter by status"
          },
          {
            "name": "jobType",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "full-time",
                "part-time",
                "remote",
                "internship"
              ]
            },
            "description": "Filter by job type"
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Case-insensitive match on position or company"
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2023-05-01"
            },
            "description": "Only jobs created on or after this day (UTC)"
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2023-05-01"
            },
            "description": "Only jobs created on or before this day (UTC)"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "latest",
                "oldest",
                "a-z",
                "z-a"
              ],
              "default": "latest"
            },
            "description": "Sort order"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "Page number"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            },
            "description": "Jobs per page"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of jobs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "jobs": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Job"
                      }
                    },
                    "totalJobs": {
                      "type": "integer"
                    },
                    "numOfPages": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid date filter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Jobs"
        ],
        "summary": "Create a job",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Job created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job": {
                      "$ref": "#/components/schemas/Job"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/stats": {
      "get": {
        "tags": [
          "Jobs"
        ],
        "summary": "Counts per status and job type, and recent monthly applications",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Stats",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stats"
                }
              }
            }
          },
          "401": {
            "description": "Authentication invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/export": {
      "get": {
        "tags": [
          "Jobs"
        ],
        "summary": "Download all matching jobs as CSV",
        "description": "Takes the same filters as the jobs list, without pages. Cells starting with = + - or @ are prefixed with a quote so spreadsheets do not run them as formulas.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "interview",
                "declined",
                "pending"
              ]
            },
            "description": "Filter by status"
          },
          {
            "name": "jobType",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "full-time",
                "part-time",
                "remote",
                "internship"
              ]
            },
            "description": "Filter by job type"
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Case-insensitive match on position or company"
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2023-05-01"
            },
            "description": "Only jobs created on or after this day (UTC)"
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2023-05-01"
            },
            "description": "Only jobs created on or before this day (UTC)"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "latest",
                "oldest",
                "a-z",
                "z-a"
              ],
              "default": "latest"
            },
            "description": "Sort order"
          }
        ],
        "responses": {
          "200": {
            "description": "CSV file (jobs.csv)",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid date filter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "tags": [
          "Jobs"
        ],
        "summary": "Get a job",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The job",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job": {
                      "$ref": "#/components/schemas/Job"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No job with this id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Jobs"
        ],
        "summary": "Update a job",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobUpdateInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated job",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job": {
                      "$ref": "#/components/schemas/Job"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No job with this id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Jobs"
        ],
        "summary": "Delete a job",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Job removed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "401": {
            "description": "Authentication invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No job with this id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/password": {
      "patch": {
        "tags": [
          "Auth"
        ],
        "summary": "Change password (tokens issued before the change stop working)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password changed, a fresh token is returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing fields, wrong current password or weak new password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Server and database status",
        "responses": {
          "200": {
            "description": "Server and database are up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Database is disconnected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "msg": {
            "type": "string"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "location": {
            "type": "string"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "token": {
            "type": "string"
          }
        }
      },
      "RegisterInput": {
        "type": "object",
        "required": [
          "name",
          "email",
          "password"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50,
            "example": "Amine"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "amine@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "pattern": "^(?=.*[A-Za-z])(?=.*\\d).{8,}$",
            "description": "At least 8 characters with a letter and a number",
            "example": "secret123"
          }
        }
      },
      "LoginInput": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "amine@example.com"
          },
          "password": {
            "type": "string",
            "example": "secret123"
          }
        }
      },
      "UpdateUserInput": {
        "type": "object",
        "required": [
          "name",
          "email"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "location": {
            "type": "string",
            "maxLength": 50
          }
        }
      },
      "JobInput": {
        "type": "object",
        "required": [
          "company",
          "position"
        ],
        "properties": {
          "company": {
            "type": "string",
            "maxLength": 50,
            "example": "Acme"
          },
          "position": {
            "type": "string",
            "maxLength": 100,
            "example": "Backend Developer"
          },
          "status": {
            "type": "string",
            "enum": [
              "interview",
              "declined",
              "pending"
            ],
            "default": "pending"
          },
          "jobType": {
            "type": "string",
            "enum": [
              "full-time",
              "part-time",
              "remote",
              "internship"
            ],
            "default": "full-time"
          },
          "jobLocation": {
            "type": "string",
            "maxLength": 100,
            "example": "Tunis"
          },
          "salaryMin": {
            "type": "number",
            "minimum": 0,
            "nullable": true,
            "example": 40000
          },
          "salaryMax": {
            "type": "number",
            "minimum": 0,
            "nullable": true,
            "example": 55000,
            "description": "Must be at least salaryMin"
          },
          "link": {
            "type": "string",
            "maxLength": 500,
            "pattern": "^https?://\\S+$",
            "example": "https://acme.dev/careers/42",
            "description": "Job posting URL (http or https only)"
          },
          "notes": {
            "type": "string",
            "maxLength": 1000,
            "example": "Referred by Sara"
          }
        }
      },
      "JobUpdateInput": {
        "type": "object",
        "properties": {
          "company": {
            "type": "string",
            "maxLength": 50,
            "example": "Acme"
          },
          "position": {
            "type": "string",
            "maxLength": 100,
            "example": "Backend Developer"
          },
          "status": {
            "type": "string",
            "enum": [
              "interview",
              "declined",
              "pending"
            ],
            "default": "pending"
          },
          "jobType": {
            "type": "string",
            "enum": [
              "full-time",
              "part-time",
              "remote",
              "internship"
            ],
            "default": "full-time"
          },
          "jobLocation": {
            "type": "string",
            "maxLength": 100,
            "example": "Tunis"
          },
          "salaryMin": {
            "type": "number",
            "minimum": 0,
            "nullable": true,
            "example": 40000
          },
          "salaryMax": {
            "type": "number",
            "minimum": 0,
            "nullable": true,
            "example": 55000,
            "description": "Must be at least salaryMin"
          },
          "link": {
            "type": "string",
            "maxLength": 500,
            "pattern": "^https?://\\S+$",
            "example": "https://acme.dev/careers/42",
            "description": "Job posting URL (http or https only)"
          },
          "notes": {
            "type": "string",
            "maxLength": 1000,
            "example": "Referred by Sara"
          }
        }
      },
      "Job": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "company": {
            "type": "string",
            "maxLength": 50,
            "example": "Acme"
          },
          "position": {
            "type": "string",
            "maxLength": 100,
            "example": "Backend Developer"
          },
          "status": {
            "type": "string",
            "enum": [
              "interview",
              "declined",
              "pending"
            ],
            "default": "pending"
          },
          "jobType": {
            "type": "string",
            "enum": [
              "full-time",
              "part-time",
              "remote",
              "internship"
            ],
            "default": "full-time"
          },
          "jobLocation": {
            "type": "string",
            "maxLength": 100,
            "example": "Tunis"
          },
          "salaryMin": {
            "type": "number",
            "minimum": 0,
            "nullable": true,
            "example": 40000
          },
          "salaryMax": {
            "type": "number",
            "minimum": 0,
            "nullable": true,
            "example": 55000,
            "description": "Must be at least salaryMin"
          },
          "link": {
            "type": "string",
            "maxLength": 500,
            "pattern": "^https?://\\S+$",
            "example": "https://acme.dev/careers/42",
            "description": "Job posting URL (http or https only)"
          },
          "notes": {
            "type": "string",
            "maxLength": 1000,
            "example": "Referred by Sara"
          },
          "statusHistory": {
            "type": "array",
            "description": "Every status the job has had, oldest first",
            "items": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "interview",
                    "declined",
                    "pending"
                  ]
                },
                "at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          "createdBy": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Stats": {
        "type": "object",
        "properties": {
          "defaultStats": {
            "type": "object",
            "properties": {
              "pending": {
                "type": "integer"
              },
              "interview": {
                "type": "integer"
              },
              "declined": {
                "type": "integer"
              }
            }
          },
          "jobTypeStats": {
            "type": "object",
            "properties": {
              "full-time": {
                "type": "integer"
              },
              "part-time": {
                "type": "integer"
              },
              "remote": {
                "type": "integer"
              },
              "internship": {
                "type": "integer"
              }
            }
          },
          "monthlyApplications": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "example": "Jul 2023"
                },
                "count": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "ChangePasswordInput": {
        "type": "object",
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "properties": {
          "currentPassword": {
            "type": "string",
            "example": "secret123"
          },
          "newPassword": {
            "type": "string",
            "minLength": 8,
            "pattern": "^(?=.*[A-Za-z])(?=.*\\d).{8,}$",
            "description": "At least 8 characters with a letter and a number",
            "example": "newSecret456"
          }
        }
      },
      "DeleteAccountInput": {
        "type": "object",
        "required": [
          "password"
        ],
        "properties": {
          "password": {
            "type": "string",
            "example": "secret123"
          }
        }
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          },
          "db": {
            "type": "string",
            "enum": [
              "connected",
              "disconnected"
            ]
          }
        }
      },
      "Message": {
        "type": "object",
        "properties": {
          "msg": {
            "type": "string"
          }
        }
      }
    }
  }
}
